  "implementation_strategy": {
    "provider": "OpenAI API",
    "api_style": "Responses API",
    "provider_abstraction": true,
    "payment_pg_now": false,
    "subscription_entitlement_now": true
  },
  "openai_configuration": {
    "provider_interface": "LlmProvider",
    "implementation": "OpenAiLlmProvider",
    "environment_variables": [
      "OPENAI_API_KEY",
      "AI_PROVIDER=openai",
      "AI_MODEL_FAST",
      "AI_MODEL_ANALYSIS",
      "AI_MODEL_CHAT"
    ],
    "rules": [
      "API KEY는 backend에서만 사용",
      "모델 ID는 환경변수로 교체 가능",

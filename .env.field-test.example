APP_PORT=8088
DB_NAME=yut_review
DB_USERNAME=yut
DB_PASSWORD=replace-before-field-test
JWT_SECRET=replace-with-at-least-32-random-characters
# Base64로 인코딩한 무작위 32바이트 이상. 디코딩해서 32바이트 미만이면 startup이 실패한다.
# 값 생성 예: openssl rand -base64 32
PHONE_HMAC_SECRET=replace-with-base64-of-32-random-bytes
# 키 회전 중에만 채운다. 재계산(POST /api/admin/operator/phone-hash/rehash)이 끝나면 비운다.
PHONE_HMAC_PREVIOUS_SECRET=
PHONE_ENCRYPTION_KEY=replace-with-base64-of-32-random-bytes
FIELD_TEST_ADMIN_EMAIL=admin@example.com
FIELD_TEST_ADMIN_PASSWORD=replace-before-field-test
FIELD_TEST_STAFF_PIN=replace-with-6-random-digits
FIELD_TEST_NAVER_PLACE_URL=https://map.naver.com/
LEGAL_BUSINESS_NAME=소담랩스
LEGAL_REPRESENTATIVE=이호영
LEGAL_BUSINESS_NUMBER=358-23-02207
LEGAL_ADDRESS=경기도 고양시 덕양구 화정로 53-1, 709 - 가1호(화정동)
LEGAL_EMAIL=privacy@example.com
LEGAL_PHONE=010-9352-3827
OPERATOR_OTP_TTL_SECONDS=120
OPERATOR_SESSION_TTL_SECONDS=600
# 실제 AI를 시험할 때 OPENAI_API_KEY만 로컬 .env.field-test에 넣는다. 키는 커밋하지 않는다.
AI_PROVIDER=auto
OPENAI_API_KEY=
AI_MODEL_FAST=gpt-4.1-mini
AI_MODEL_ANALYSIS=gpt-4.1
AI_MODEL_CHAT=gpt-4.1-mini

# 포트원 V2 요금제 자동결제. 넷 중 하나라도 비면 결제 버튼이 숨고 등급 변경은 운영자 조작만 남는다.
# API Secret은 포트원 콘솔 [연동 관리] > [식별코드·API Keys] > V2 API에서 발급한다. 커밋하지 말 것.
# 채널 키는 [채널 관리]에서 확인한다. 아래 값은 공용 테스트 채널(실제 청구 없음)이다.
PORTONE_API_SECRET=
PORTONE_STORE_ID=store-d53c41a6-8a2c-40fd-b42b-b772d25d188f
PORTONE_TOSS_CHANNEL_KEY=channel-key-ed42171a-c98b-41c4-9521-ffd95e91f1a5
PORTONE_INICIS_CHANNEL_KEY=channel-key-87edca4f-3a31-4171-8c55-a518f345e942

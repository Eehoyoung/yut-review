APP_PORT=8088
DB_NAME=yut_review
DB_USERNAME=yut
DB_PASSWORD=replace-before-field-test
JWT_SECRET=replace-with-at-least-32-random-characters
PHONE_HMAC_SECRET=replace-with-a-long-random-secret
PHONE_ENCRYPTION_KEY=replace-with-base64-of-32-random-bytes
FIELD_TEST_ADMIN_EMAIL=admin@example.com
FIELD_TEST_ADMIN_PASSWORD=replace-before-field-test
FIELD_TEST_STAFF_PIN=replace-with-6-random-digits
FIELD_TEST_NAVER_PLACE_URL=https://map.naver.com/

# 운영자 콘솔(/admin/system). 두 값이 모두 있고 그 이메일의 계정이 없을 때만 운영자 계정을 만든다.
# 첫 로그인에서 인증 앱(TOTP) 등록을 마쳐야 콘솔이 열린다.
SYSTEM_ADMIN_EMAIL=ops@example.com
SYSTEM_ADMIN_PASSWORD=replace-with-at-least-12-characters
# 비우면 IP로는 막지 않는다. 쉼표로 구분한 IP 또는 CIDR(예: 203.0.113.4,10.0.0.0/8).
# Cloudflare 터널을 거치면 모든 요청이 터널 IP로 보여 이 값이 사실상 무의미하다.
SYSTEM_CONSOLE_ALLOWED_IPS=
# 세션 최대 시간 / 자리 비움 시 종료 / 위험한 조작 앞 재인증 간격 (분)
SYSTEM_CONSOLE_SESSION_MINUTES=60
SYSTEM_CONSOLE_IDLE_MINUTES=15
SYSTEM_CONSOLE_STEP_UP_MINUTES=5
# 동시 세션 수, 연속 실패 잠금 기준과 잠금 시간
SYSTEM_CONSOLE_MAX_SESSIONS=5
SYSTEM_CONSOLE_MAX_FAILED_ATTEMPTS=10
SYSTEM_CONSOLE_LOCK_MINUTES=15
SYSTEM_CONSOLE_ENABLED=true

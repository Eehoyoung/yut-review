            "findingId": "csf_84ca5e6f84e16b38e9f1b362",
            "occurrenceId": "occ_c36624b46c42c02346c8f590",
            "severity": "medium"
          },
          "ruleId": "rate-limit.proxy-identity-collapse",
          "ruleIndex": 6
        },

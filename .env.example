DB_NAME=yut_review
DB_USERNAME=yut
DB_PASSWORD=replace-with-a-local-password
JWT_SECRET=replace-with-at-least-32-random-characters
# Base64로 인코딩한 무작위 32바이트 이상. 디코딩해서 32바이트 미만이면 startup이 실패한다.
# 값 생성 예: openssl rand -base64 32
PHONE_HMAC_SECRET=replace-with-base64-of-32-random-bytes
# 키 회전 중에만 채운다. 재계산(POST /api/admin/operator/phone-hash/rehash)이 끝나면 비운다.
PHONE_HMAC_PREVIOUS_SECRET=
PHONE_ENCRYPTION_KEY=replace-with-base64-of-32-random-bytes
LEGAL_BUSINESS_NAME=replace-after-business-registration
LEGAL_REPRESENTATIVE=replace-after-business-registration
LEGAL_BUSINESS_NUMBER=replace-after-business-registration
LEGAL_ADDRESS=replace-after-business-registration
LEGAL_EMAIL=privacy@example.com
LEGAL_PHONE=replace-after-business-registration
